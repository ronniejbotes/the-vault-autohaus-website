# The Vault SA, live on https://thevaultppf.co.za/ from 29 Oct 2026: indexable (the preview's noindex is gone).
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
RewriteEngine On
# One address: www goes to the bare domain (http to https is done by Hostinger already).
RewriteCond %{HTTP_HOST} ^www\.thevaultppf\.co\.za$ [NC]
RewriteRule ^ https://thevaultppf.co.za%{REQUEST_URI} [R=301,L]
# /index.html is the home page: one address for it.
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
# Internal notes from the repo are not for the public.
RewriteRule (^|/)[^/]+\.md$ - [F,L]
RewriteRule (^|/)\.git(/|$) - [F,L]
</IfModule>

# Security headers (12 Nov 2026): the same block as positionxero.com's on this
# host, plus HSTS. They change nothing a visitor sees: no sniffing of file
# types, no framing by other sites, only the domain (not the full address)
# sent to other sites as the referrer, no camera, microphone or location
# access, and browsers keep to https for a year. HSTS has no includeSubDomains
# and no preload, so a subdomain without https is never locked out.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
